#!/bin/sh
# The old package's upgrade erase must not alter the new controller. Ordinary
# removal preserves /etc/vibeshine and /var/lib/vibeshine, including pairings.
if [ "${1:-}" = 0 ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl daemon-reload || exit 1
fi
